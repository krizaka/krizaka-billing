<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <!-- Built on the Krizaka build (krizaka/krizaka-build): Maven Central metadata, Java 21
         conventions and the signed release. Inside a workspace that clones krizaka-build next to
         this repository the relativePath resolves it from source; anywhere else it comes from
         Maven Central. -->
    <parent>
        <groupId>com.krizaka</groupId>
        <artifactId>krizaka-parent</artifactId>
        <version>0.2.0</version>
        <relativePath>../krizaka-build/krizaka-parent/pom.xml</relativePath>
    </parent>

    <artifactId>krizaka-billing</artifactId>
    <packaging>pom</packaging>
    <name>Krizaka Billing</name>
    <description>Credits, wallets, plans, subscriptions, pricebook and metering (hold → settle → release) as a reusable billing service, with its contract (billing-api) and a typed HTTP client (billing-client).</description>
    <url>https://github.com/krizaka/krizaka-billing</url>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <url>https://github.com/krizaka/krizaka-billing</url>
        <connection>scm:git:https://github.com/krizaka/krizaka-billing.git</connection>
        <developerConnection>scm:git:git@github.com:krizaka/krizaka-billing.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/krizaka/krizaka-billing/issues</url>
    </issueManagement>

    <properties>
        <archunit.version>1.3.0</archunit.version>
        <!-- What reaches Maven Central: the libraries, never a runnable service. A *-service module
             sets maven.deploy.skip (the services ship as Docker images, built from source); every
             other module with sources is published, and its jar must stay under
             krizaka.publishable.max-size (enforcer, verify phase — a fat jar fails the build). -->
        <maven.deploy.skip>false</maven.deploy.skip>
        <krizaka.publishable.max-size>5242880</krizaka.publishable.max-size>
    </properties>

    <modules>
        <module>krizaka-billing-api</module>
        <module>krizaka-billing-client</module>
        <module>krizaka-billing-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- The other Krizaka artifacts, at this repository's own version. -->
            <dependency>
                <groupId>com.krizaka</groupId>
                <artifactId>krizaka-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <!-- /actuator/info says which build is running. -->
                        <execution>
                            <id>build-info</id>
                            <goals>
                                <goal>build-info</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!-- The Central bundle never carries a service host: central-publishing-maven-plugin
                     stages every module of the reactor, maven.deploy.skip or not, so the hosts are
                     excluded by name. They ship as Docker images. -->
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <configuration>
                        <excludeArtifacts>
                            <excludeArtifact>krizaka-billing-service</excludeArtifact>
                        </excludeArtifacts>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Publishable-artifact guard: a module with Java sources that Maven Central receives
             (maven.deploy.skip=false) must produce a jar under 5 MB. Active in every module that
             has src/main/java; the *-service hosts skip it with their deployment. -->
        <profile>
            <id>publishable-artifact-size</id>
            <activation>
                <file>
                    <exists>${basedir}/src/main/java</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>publishable-artifact-size</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <skip>${maven.deploy.skip}</skip>
                                    <rules>
                                        <requireFilesSize>
                                            <maxsize>${krizaka.publishable.max-size}</maxsize>
                                            <files>
                                                <file>${project.build.directory}/${project.build.finalName}.jar</file>
                                            </files>
                                            <message>A published artifact must stay small: a runnable (fat) jar never goes to Maven Central. Set maven.deploy.skip=true in a service module; it ships as a Docker image.</message>
                                        </requireFilesSize>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
